                                        <option value="">-- Sélectionnez une catégorie --</option>
                                        {% for option in cat_from_options %}
                                            <option value="{{ option }}" {% if option == form_values.cat_from %}selected{% endif %}>{{ option }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="country">Pays :</label>
                                    <input type="text" class="form-control" id="country" name="country" value="{{ form_values.country }}">
                                </div>
                            </div>
                        </div>
                    </section>
                    <br>
                    <section>
                        <div class="form-group text-right" >
                            <button type="submit" class="btn btn-danger">Prédire</button>
                        </div>
                    </section>
                </form>
            </div>

            {% if error %}
