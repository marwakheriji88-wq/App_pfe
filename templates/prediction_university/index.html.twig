                    <h5>Prédire la transition de catégorie d'une université</h5>
                    <br>
                    <section>
                        <div class="row">
                            {% for field in numeric_fields %}
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="{{ field }}">{{ field }}</label>
                                        <input
                                                type="number"
                                                step="any"
                                                class="form-control"
                                                id="{{ field }}"
                                                name="{{ field }}"
                                                value="{{ form_values[field] }}">
                                    </div>
                                </div>
                            {% endfor %}

                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="cat_from">Catégorie actuelle (cat_from) :</label>
