                    <strong>Transition prédite :</strong> {{ prediction }}
                    {% if probabilities %}
                        <ul>
                            {% for label, proba in probabilities %}
                                <li>{{ label }} : {{ (proba * 100)|round(1) }}%</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
